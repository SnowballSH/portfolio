{
	admin off
	auto_https off

	log default {
		output stdout
		format json
		level INFO
	}
}

http://:8080 {
	root * /srv
	encode zstd gzip

	@health path /health/live /health/ready
	respond @health "ok" 200

	@blogs path /blogs /blogs/*
	redir @blogs https://blogs.snowballsh.com permanent

	@hashed path /_astro/*
	header @hashed Cache-Control "public, max-age=31536000, immutable"

	file_server

	handle_errors {
		@404 expression {http.error.status_code} == 404
		rewrite @404 /404.html
		file_server
	}
}
