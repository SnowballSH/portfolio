---
import "../styles/global.css";
import Navbar from "../components/Navbar.astro";

export interface Props {
	title?: string;
	description?: string;
}

const {
	title = "SnowballSH Portfolio",
	description = "Portfolio showcasing SnowballSH projects and skills",
} = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />

		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Poppins:wght@300;400;500;600;700;800&display=swap"
			rel="stylesheet"
		/>

		<title>{title}</title>
	</head>
	<body class="bg-dark-950 text-white font-sans antialiased">
		<Navbar />
		<slot />
	</body>
</html>
