---
import "../styles/global.css";
import Navbar from "../components/Navbar.astro";
import EmailLink from "../components/EmailLink.astro";
import { email, profiles } from "../data/contact";
import { Footer, Link } from "foundationui/svelte";

export interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: "website" | "article" | "profile";
  canonical?: string;
  noindex?: boolean;
  keywords?: string | string[];
  publishedTime?: string;
  modifiedTime?: string;
  schema?: Record<string, unknown> | Array<Record<string, unknown>>;
}

const {
  title = "SnowballSH (Yinuo Huang)",
  description = "Portfolio showcasing SnowballSH (Yinuo Huang) projects and skills",
  image = "/favicon.webp",
  type = "website",
  canonical,
  noindex = false,
  keywords = [
    "SnowballSH",
    "Yinuo Huang",
    "software developer",
    "portfolio",
    "projects",
  ],
  publishedTime,
  modifiedTime,
  schema,
} = Astro.props;

const site = Astro.site ?? new URL("https://snowballsh.com");

const normalizeUrl = (value: string) => new URL(value, site).toString();
const canonicalUrl = normalizeUrl(canonical ?? Astro.url.pathname);
const imageUrl = normalizeUrl(image);
const keywordContent = Array.isArray(keywords) ? keywords.join(",") : keywords;
const robotsContent = noindex ? "noindex, nofollow" : "index, follow";
const schemaItems = schema ? (Array.isArray(schema) ? schema : [schema]) : [];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/webp" href="/favicon.webp" />
    <meta name="generator" content={Astro.generator} />
    <meta name="author" content="Yinuo Huang" />
    <meta name="description" content={description} />
    <meta name="keywords" content={keywordContent} />
    <meta name="robots" content={robotsContent} />
    <meta
      name="theme-color"
      media="(prefers-color-scheme: light)"
      content="#fbfdff"
    />
    <meta
      name="theme-color"
      media="(prefers-color-scheme: dark)"
      content="#0a1220"
    />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={type} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content="SnowballSH (Yinuo Huang)" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    {
      publishedTime && (
        <meta property="article:published_time" content={publishedTime} />
      )
    }
    {
      modifiedTime && (
        <meta property="article:modified_time" content={modifiedTime} />
      )
    }
    <link rel="canonical" href={canonicalUrl} />
    <link
      rel="sitemap"
      type="application/xml"
      href={normalizeUrl("/sitemap-index.xml")}
    />
    {
      schemaItems.map((item) => (
        <script
          is:inline
          type="application/ld+json"
          set:html={JSON.stringify(item)}
        />
      ))
    }
    <script is:inline>
      (() => {
        let theme = "light";
        try {
          const stored = localStorage.getItem("fui-theme");
          theme =
            stored === "light" || stored === "dark"
              ? stored
              : matchMedia("(prefers-color-scheme: dark)").matches
                ? "dark"
                : "light";
        } catch {}
        document.documentElement.dataset.theme = theme;
      })();
    </script>

    <title>{title}</title>
  </head>
  <body
    class="bg-surface text-ink flex min-h-svh flex-col font-sans antialiased"
  >
    <div
      class="pointer-events-none fixed inset-0 -z-10 bg-[radial-gradient(60rem_40rem_at_85%_-10%,color-mix(in_oklab,var(--fui-accent)_20%,transparent),transparent),radial-gradient(50rem_36rem_at_-10%_110%,color-mix(in_oklab,var(--fui-aurora)_16%,transparent),transparent),radial-gradient(38rem_26rem_at_50%_50%,color-mix(in_oklab,var(--fui-accent)_7%,transparent),transparent)]"
    >
    </div>
    <Navbar />
    <div class="flex-1">
      <slot />
    </div>
    <Footer>
      <div class="flex flex-wrap items-center justify-between gap-4">
        <span>© 2026 SnowballSH · Yinuo Huang</span>
        <div class="flex flex-wrap items-center gap-x-4 gap-y-1">
          {
            profiles
              .filter((profile) => profile.label !== "Codeforces")
              .map((profile) => (
                <Link subtle href={profile.url} external>
                  {profile.label}
                </Link>
              ))
          }
          <EmailLink address={email} label="Email" subtle />
        </div>
      </div>
    </Footer>
  </body>
</html>
