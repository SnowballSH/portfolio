---
import "../styles/global.css";
import Navbar from "../components/Navbar.astro";

export interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: "website" | "article" | "profile";
  canonical?: string;
  noindex?: boolean;
  keywords?: string | string[];
  publishedTime?: string;
  modifiedTime?: string;
  schema?: Record<string, unknown> | Array<Record<string, unknown>>;
}

const {
  title = "SnowballSH (Yinuo Huang)",
  description = "Portfolio showcasing SnowballSH (Yinuo Huang) projects and skills",
  image = "/favicon.webp",
  type = "website",
  canonical,
  noindex = false,
  keywords = [
    "SnowballSH",
    "Yinuo Huang",
    "software developer",
    "portfolio",
    "projects",
    "blog",
  ],
  publishedTime,
  modifiedTime,
  schema,
} = Astro.props;

const site = Astro.site ?? new URL("https://snowballsh.github.io");

const normalizeUrl = (value: string) => new URL(value, site).toString();
const canonicalUrl = normalizeUrl(canonical ?? Astro.url.pathname);
const imageUrl = normalizeUrl(image);
const keywordContent = Array.isArray(keywords) ? keywords.join(",") : keywords;
const robotsContent = noindex ? "noindex, nofollow" : "index, follow";
const schemaItems = schema ? (Array.isArray(schema) ? schema : [schema]) : [];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/webp" href="/favicon.webp" />
    <meta http-equiv="Cache-Control" content="public, max-age=31536000" />
    <meta name="generator" content={Astro.generator} />
    <meta name="author" content="Yinuo Huang" />
    <meta name="description" content={description} />
    <meta name="keywords" content={keywordContent} />
    <meta name="robots" content={robotsContent} />
    <meta name="theme-color" content="#0f172a" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={type} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content="SnowballSH (Yinuo Huang)" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    {
      publishedTime && (
        <meta property="article:published_time" content={publishedTime} />
      )
    }
    {
      modifiedTime && (
        <meta property="article:modified_time" content={modifiedTime} />
      )
    }
    <link rel="canonical" href={canonicalUrl} />
    <link
      rel="sitemap"
      type="application/xml"
      href={normalizeUrl("/sitemap-index.xml")}
    />
    {
      schemaItems.map((item) => (
        <script type="application/ld+json" set:html={JSON.stringify(item)} />
      ))
    }
    <script is:inline>
      (() => {
        try {
          if (localStorage.getItem("snowballsh-animations") === "enabled") {
            document.documentElement.classList.add("animations-enabled");
          }
        } catch {
          document.documentElement.classList.remove("animations-enabled");
        }
      })();
    </script>

    <title>{title}</title>
  </head>
  <body
    class="bg-slate-950 font-sans text-slate-50 antialiased selection:bg-cyan-300/30"
  >
    <Navbar />
    <label class="motion-toggle" title="Enable background animations">
      <input
        id="background-animation-toggle"
        type="checkbox"
        aria-label="Enable background animations"
      />
      <span>Motion</span>
    </label>
    <slot />
    <script is:inline>
      (() => {
        const checkbox = document.getElementById("background-animation-toggle");

        if (!(checkbox instanceof HTMLInputElement)) {
          return;
        }

        const root = document.documentElement;
        checkbox.checked = root.classList.contains("animations-enabled");

        checkbox.addEventListener("change", () => {
          root.classList.toggle("animations-enabled", checkbox.checked);

          try {
            localStorage.setItem(
              "snowballsh-animations",
              checkbox.checked ? "enabled" : "disabled",
            );
          } catch {
            // The class still updates for the current page if storage is unavailable.
          }
        });
      })();
    </script>
  </body>
</html>
