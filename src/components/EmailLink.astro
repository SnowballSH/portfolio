---
import { Link } from "foundationui/svelte";
import { encodeEmail } from "../lib/email";

interface Props {
  address: string;
  label?: string;
  subtle?: boolean;
  class?: string;
}

const { address, label, subtle, class: className } = Astro.props;
---

<Link
  href="/contact"
  data-email={encodeEmail(address)}
  data-email-label={label ? "" : undefined}
  {subtle}
  class={className}
>
  {label ?? "Enable JavaScript to show email"}
</Link>

<script>
import { revealEmailLinks } from "../lib/email";

revealEmailLinks(document);
</script>
