---
import { Header, Link, ThemeToggle } from "foundationui/svelte";

const navItems = [
  { href: "/", label: "Home" },
  { href: "/projects", label: "Projects" },
  { href: "https://blogs.snowballsh.com", label: "Blogs", external: true },
  { href: "/contact", label: "Contact" },
];

const currentPath = Astro.url.pathname;
const isCurrent = (href: string) =>
  href === "/" ? currentPath === "/" : currentPath.startsWith(href);
---

<Header>
  <a
    href="/"
    class="font-display text-ink flex items-center gap-2 text-sm font-semibold tracking-wide whitespace-nowrap"
  >
    <img
      src="/favicon.webp"
      alt=""
      width="28"
      height="28"
      decoding="async"
      class="h-7 w-7 rounded-md object-cover"
    />
    SnowballSH
  </a>
  <nav
    aria-label="Site"
    class="flex flex-wrap items-center gap-x-3 gap-y-1 text-sm sm:gap-x-5"
  >
    {
      navItems.map((item) => (
        <Link
          href={item.href}
          external={item.external}
          subtle={!isCurrent(item.href)}
          aria-current={isCurrent(item.href) ? "page" : undefined}
          class={isCurrent(item.href) ? "font-medium" : undefined}
        >
          {item.label}
        </Link>
      ))
    }
    <ThemeToggle client:load />
  </nav>
</Header>
