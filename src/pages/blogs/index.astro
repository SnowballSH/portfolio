---
import Layout from "../../layouts/Layout.astro";
import { getCollection } from "astro:content";

const parseDateString = (date: string) => {
  const [year, month, day] = date.split("-").map(Number);
  return new Date(year, month - 1, day);
};

const blogs = (await getCollection("blogs"))
  .filter((entry) => !entry.data.draft)
  .sort(
    (a, b) =>
      parseDateString(b.data.date).getTime() -
      parseDateString(a.data.date).getTime(),
  );

const formatDate = (date: string) =>
  new Intl.DateTimeFormat("en-US", {
    year: "numeric",
    month: "long",
    day: "numeric",
  }).format(parseDateString(date));

const site = Astro.site ?? new URL("https://snowballsh.github.io");
const blogListSchema = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  name: "Blogs - SnowballSH",
  description: "Blog posts by SnowballSH (Yinuo Huang).",
  url: new URL(Astro.url.pathname, site).toString(),
  mainEntity: {
    "@type": "ItemList",
    itemListElement: blogs.map((blog, index) => ({
      "@type": "ListItem",
      position: index + 1,
      url: new URL(`/blogs/${blog.slug}`, site).toString(),
      name: blog.data.title,
    })),
  },
};
---

<Layout
  title="Blogs - SnowballSH (Yinuo Huang)"
  description="Blog posts by SnowballSH (Yinuo Huang)."
  keywords={["SnowballSH", "Yinuo Huang", "blog", "typst", "technical writing"]}
  schema={blogListSchema}
>
  <div class="futuristic-bg"></div>
  <div class="geometric-overlay"></div>

  <div class="pointer-events-none fixed inset-0 z-0 overflow-hidden">
    <div class="particle"></div>
    <div class="particle"></div>
    <div class="particle"></div>
    <div class="particle"></div>
    <div class="particle"></div>
    <div class="particle"></div>
    <div class="particle"></div>
    <div class="particle"></div>
    <div class="particle"></div>
  </div>

  <main class="relative z-10 min-h-screen">
    <section class="pt-32 pb-20">
      <div class="container mx-auto px-6 text-center">
        <h1
          class="section-heading mb-5 text-5xl font-bold text-white md:text-6xl"
        >
          Blogs
        </h1>
        <p class="section-lead mx-auto max-w-3xl text-lg md:text-xl">
          Personal and Academic Blogs. Maybe Philosophical. Maybe Mathematical.
          Or both.
        </p>
        <p class="mt-4 text-sm text-sky-100/70 md:text-base">
          {blogs.length} post{blogs.length === 1 ? "" : "s"}
        </p>
      </div>
    </section>

    <section class="pb-24">
      <div class="container mx-auto px-6">
        {
          blogs.length > 0 ? (
            <div class="mosaic-grid mx-auto grid max-w-5xl grid-cols-1 gap-6 lg:grid-cols-2">
              {blogs.map((blog) => (
                <article class="glass-card flex h-full flex-col p-6">
                  <p class="text-sm text-sky-100/75">
                    {formatDate(blog.data.date)}
                  </p>
                  <h2 class="section-heading mt-3 text-2xl font-semibold text-white">
                    <a href={`/blogs/${blog.slug}`} class="hover:underline">
                      {blog.data.title}
                    </a>
                  </h2>
                  {blog.data.description && (
                    <p class="section-lead mt-3 grow text-base">
                      {blog.data.description}
                    </p>
                  )}
                  {blog.data.tags.length > 0 && (
                    <div class="mt-5 flex flex-wrap gap-2">
                      {blog.data.tags.map((tag) => (
                        <span class="rounded-full bg-sky-400/15 px-3 py-1 text-sm text-sky-100/90">
                          #{tag}
                        </span>
                      ))}
                    </div>
                  )}
                  <a
                    href={`/blogs/${blog.slug}`}
                    class="mt-6 inline-flex items-center text-sky-200 transition-colors hover:text-white"
                  >
                    Read Post →
                  </a>
                </article>
              ))}
            </div>
          ) : (
            <div class="glass-panel mx-auto max-w-3xl text-center">
              <h2 class="section-heading mb-4 text-3xl font-bold text-white">
                No Blog Posts Yet
              </h2>
              <p class="section-lead">
                Add a `.typ` file inside `src/content/blogs/` to publish your
                first Typst blog.
              </p>
            </div>
          )
        }
      </div>
    </section>
  </main>
</Layout>
