---
import Layout from "../layouts/Layout.astro";
---

<Layout
  title="Contact - SnowballSH (Yinuo Huang)"
  description="Get in touch with SnowballSH (Yinuo Huang)"
>
  <div class="futuristic-bg"></div>
  <div class="geometric-overlay"></div>

  <div class="pointer-events-none fixed inset-0 z-0 overflow-hidden">
    <div class="particle"></div>
    <div class="particle"></div>
    <div class="particle"></div>
    <div class="particle"></div>
    <div class="particle"></div>
  </div>

  <main class="relative z-10 pt-20">
    <section class="flex min-h-screen items-center py-20">
      <div class="container mx-auto px-6">
        <div class="mx-auto max-w-4xl">
          <div class="mb-16 space-y-5 text-center">
            <h1
              class="section-heading text-glow text-5xl font-bold md:text-6xl"
            >
              Let's Connect
            </h1>
            <p class="section-lead mx-auto max-w-2xl text-lg md:text-xl">
              I am currently a student at the School of Computer Science at
              Carnegie Mellon University studying Computer Science and AI with a
              minor in Math. I am excited to discuss new ideas. Here are ways
              you can reach out:
            </p>
          </div>

          <div class="flex justify-center">
            <div
              class="mosaic-grid contact-grid grid w-full max-w-3xl grid-cols-1 gap-6 md:grid-cols-2"
            >
              <div class="glass-panel contact-card text-center">
                <div class="contact-card-content">
                  <div
                    class="contact-icon bg-primary-500 flex h-16 w-16 items-center justify-center rounded-lg"
                  >
                    <svg
                      class="h-8 w-8 text-white"
                      fill="none"
                      stroke="currentColor"
                      viewBox="0 0 24 24"
                    >
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M3 8l7.89 4.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"
                      ></path>
                    </svg>
                  </div>
                  <h3 class="contact-title text-xl font-semibold text-white">
                    Email
                  </h3>
                  <p class="contact-value text-primary-300 text-lg font-medium">
                    yinuohuang at cmu dot edu
                  </p>
                </div>
              </div>

              <div class="glass-panel contact-card text-center">
                <div class="contact-card-content">
                  <div
                    class="contact-icon bg-primary-500 flex h-16 w-16 items-center justify-center rounded-lg"
                  >
                    <svg
                      class="h-8 w-8 text-white"
                      fill="currentColor"
                      viewBox="0 0 24 24"
                    >
                      <path
                        d="M20.317 4.37a19.791 19.791 0 0 0-4.885-1.515.074.074 0 0 0-.079.037c-.21.375-.444.864-.608 1.25a18.27 18.27 0 0 0-5.487 0 12.64 12.64 0 0 0-.617-1.25.077.077 0 0 0-.079-.037A19.736 19.736 0 0 0 3.677 4.37a.07.07 0 0 0-.032.027C.533 9.046-.32 13.58.099 18.057a.082.082 0 0 0 .031.057 19.9 19.9 0 0 0 5.993 3.03.078.078 0 0 0 .084-.028c.462-.63.874-1.295 1.226-1.994a.076.076 0 0 0-.041-.106 13.107 13.107 0 0 1-1.872-.892.077.077 0 0 1-.008-.128 10.2 10.2 0 0 0 .372-.292.074.074 0 0 1 .077-.010c3.928 1.793 8.18 1.793 12.062 0a.074.074 0 0 1 .078.01c.12.098.246.198.373.292a.077.077 0 0 1-.006.127 12.299 12.299 0 0 1-1.873.892.077.077 0 0 0-.041.107c.36.698.772 1.362 1.225 1.993a.076.076 0 0 0 .084.028 19.839 19.839 0 0 0 6.002-3.03.077.077 0 0 0 .032-.054c.5-5.177-.838-9.674-3.549-13.66a.061.061 0 0 0-.031-.03zM8.02 15.33c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.956-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.956 2.418-2.157 2.418zm7.975 0c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.955-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.946 2.418-2.157 2.418z"
                      ></path>
                    </svg>
                  </div>
                  <h3 class="contact-title text-xl font-semibold text-white">
                    Discord
                  </h3>
                  <p class="contact-value text-primary-300 text-lg font-medium">
                    SnowballSH
                  </p>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>
</Layout>

<style>
  .contact-grid > * {
    margin-top: 0 !important;
  }

  .contact-card {
    min-height: 14.5rem;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1.75rem 1.25rem;
    opacity: 0;
    transform: translateY(16px);
    animation: contact-card-enter 0.45s ease forwards;
  }

  .contact-card-content {
    display: grid;
    grid-template-rows: auto auto auto;
    row-gap: 0.75rem;
    width: 100%;
    justify-items: center;
  }

  .contact-icon {
    margin: 0;
  }

  .contact-title,
  .contact-value {
    margin: 0;
    line-height: 1.2;
  }

  .contact-value {
    display: flex;
    min-height: 1.5em;
    align-items: center;
    justify-content: center;
    white-space: nowrap;
  }

  .contact-card:nth-of-type(2) {
    animation-delay: 0.1s;
  }

  .glass-panel:hover {
    transform: translateY(-2px);
    box-shadow: 0 12px 36px rgba(64, 170, 230, 0.2);
  }

  @media (prefers-reduced-motion: reduce) {
    .contact-card {
      animation: none;
      opacity: 1;
      transform: none;
    }
  }

  @keyframes contact-card-enter {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>
