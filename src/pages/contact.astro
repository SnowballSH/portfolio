---
import Layout from "../layouts/Layout.astro";
import EmailLink from "../components/EmailLink.astro";
import { email, profiles } from "../data/contact";
import { Link, Panel } from "foundationui/svelte";
---

<Layout
  cta={false}
  title="Contact - SnowballSH (Yinuo Huang)"
  description="Get in touch with SnowballSH (Yinuo Huang)"
>
  <main class="mx-auto w-full max-w-4xl px-4 py-10 sm:px-6">
    <section class="py-14">
      <div class="mb-14 space-y-5 text-center">
        <h1 class="font-display text-ink text-4xl font-bold tracking-tight md:text-5xl">
          Let's Connect
        </h1>
        <p class="text-ink-secondary mx-auto max-w-2xl text-lg md:text-xl">
          I am currently a student at the School of Computer Science at Carnegie
          Mellon University studying Computer Science with a minor in Math. I am
          excited to discuss new ideas. Here are ways you can reach out:
        </p>
      </div>

      <div class="mx-auto grid max-w-3xl grid-cols-1 gap-6 sm:grid-cols-2">
        <Panel
          tier="glass"
          padding="lg"
          class="flex min-h-32 flex-col items-center justify-center gap-2 text-center sm:col-span-2"
        >
          <h2 class="font-display text-ink text-xl font-semibold">Email</h2>
          <p class="text-lg font-medium">
            <EmailLink address={email} />
          </p>
        </Panel>
        {profiles.map((profile) => (
          <Panel
            tier="glass"
            padding="lg"
            class="flex min-h-32 flex-col items-center justify-center gap-2 text-center"
          >
            <h2 class="font-display text-ink text-xl font-semibold">
              {profile.label}
            </h2>
            <p class="text-lg font-medium">
              <Link href={profile.url} external>
                {profile.handle}
              </Link>
            </p>
          </Panel>
        ))}
      </div>

      <p class="text-ink-secondary mx-auto mt-10 max-w-2xl text-center text-base">
        You can also find me on Discord as{" "}
        <span class="text-ink font-medium">SnowballSH</span>. For
        academic-related information about me, see my{" "}
        <Link href="https://www.andrew.cmu.edu/user/yinuohua/" external>
          CMU academic profile
        </Link>
        .
      </p>
    </section>
  </main>
</Layout>
