---
import { Link, Panel } from "foundationui/svelte";
import EmailLink from "../components/EmailLink.astro";
import { email } from "../data/contact";
import Layout from "../layouts/Layout.astro";

const description =
  "Rimehand is a long-term project exploring a generalist robot that can perceive, reason about, and play many physical tabletop games.";

const schema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: "Rimehand",
  url: "https://snowballsh.com/rimehand/",
  description,
};
---

<Layout
  cta={false}
  title="Rimehand — Coming Soon"
  description={description}
  canonical="https://snowballsh.com/rimehand/"
  keywords={[
  "Rimehand",
  "robotics",
  "generalist robotics",
  "game-playing robot",
  "tabletop games",
]}
  schema={schema}
>
  <main
    class="mx-auto grid w-full max-w-5xl flex-1 place-items-center px-4 py-16 sm:px-6"
  >
    <section aria-labelledby="rimehand-title" class="w-full">
      <Panel tier="glass" padding="lg" class="p-8 sm:p-14">
        <p
          class="text-accent mb-6 font-mono text-xs font-bold tracking-[0.14em] uppercase"
        >
          Rimehand · Generalist game-playing robotics
        </p>

        <h1
          id="rimehand-title"
          class="font-display text-ink max-w-[12ch] text-5xl font-bold tracking-tight md:text-7xl"
        >
          Rimehand is
          <br>
          <span class="text-accent">coming soon.</span>
        </h1>

        <p class="text-ink-secondary mt-8 max-w-2xl text-lg leading-relaxed">
          A long-term project to build a generalist robot that can perceive,
          reason about, and play many physical tabletop games—without being
          redesigned for each one.
        </p>

        <div
          class="mt-10 flex flex-wrap items-center gap-x-7 gap-y-5 font-mono text-sm"
        >
          <Link href="https://rimehand.snowballsh.com" external>
            Visit the Rimehand site ↗
          </Link>
          <EmailLink address={email} subtle />
        </div>

        <p
          class="text-ink-muted mt-14 font-mono text-[0.68rem] tracking-[0.13em] uppercase"
        >
          A SnowballSH project
        </p>
      </Panel>
    </section>
  </main>
</Layout>
