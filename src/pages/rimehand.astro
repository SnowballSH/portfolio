---
import Layout from "../layouts/Layout.astro";

const description =
  "Rimehand is a long-term project exploring a generalist robot that can perceive, reason about, and play many physical tabletop games.";

const schema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: "Rimehand",
  url: "https://snowballsh.com/rimehand/",
  email: "mailto:yinuo@snowballsh.com",
  description,
};
---

<Layout
  title="Rimehand — Coming Soon"
  description={description}
  canonical="https://snowballsh.com/rimehand/"
  keywords={[
    "Rimehand",
    "robotics",
    "generalist robotics",
    "game-playing robot",
    "tabletop games",
  ]}
  schema={schema}
>
  <main class="rimehand-page">
    <div class="futuristic-bg" aria-hidden="true"></div>
    <div class="geometric-overlay" aria-hidden="true"></div>
    <div class="glow-orb glow-orb-one" aria-hidden="true"></div>
    <div class="glow-orb glow-orb-two" aria-hidden="true"></div>

    <section class="rimehand-hero" aria-labelledby="rimehand-title">
      <div class="rimehand-card glass-panel">
        <p class="eyebrow">Rimehand · Generalist game-playing robotics</p>

        <h1 id="rimehand-title">
          Rimehand is<br />
          <span class="accent">coming soon.</span>
        </h1>

        <p class="description">
          A long-term project to build a generalist robot that can perceive,
          reason about, and play many physical tabletop games—without being
          redesigned for each one.
        </p>

        <div class="actions">
          <a
            class="primary-action"
            href="https://rimehand.snowballsh.com"
            target="_blank"
            rel="noopener noreferrer"
          >
            Visit the Rimehand site
            <span aria-hidden="true">↗</span>
          </a>

          <a class="email-link" href="mailto:yinuo@snowballsh.com">
            yinuo@snowballsh.com
          </a>
        </div>

        <p class="project-note">A SnowballSH project</p>
      </div>
    </section>
  </main>
</Layout>

<style>
  .rimehand-page {
    --rimehand-accent: #74d8ff;
    --rimehand-line: rgba(199, 234, 255, 0.3);
    --rimehand-ink: var(--text-primary);
    --rimehand-muted: var(--text-secondary);
    --rimehand-muted-subtle: rgba(217, 235, 247, 0.62);
    --rimehand-surface: #111c31;

    position: relative;
    display: grid;
    min-height: calc(100vh - 4rem);
    min-height: calc(100svh - 4rem);
    place-items: center;
    overflow: hidden;
    padding: clamp(3rem, 8vw, 7rem) 1.25rem;
  }

  .rimehand-hero {
    position: relative;
    z-index: 1;
    width: min(100%, 62rem);
  }

  .rimehand-card {
    position: relative;
    overflow: hidden;
    padding: clamp(2rem, 6vw, 5rem);
    border-color: color-mix(
      in srgb,
      var(--rimehand-accent) 26%,
      var(--rimehand-line)
    );
    box-shadow:
      0 2rem 6rem rgb(0 0 0 / 0.28),
      inset 0 1px rgb(255 255 255 / 0.08);
  }

  .rimehand-card::before {
    position: absolute;
    inset: 0 auto auto 0;
    width: 8rem;
    height: 2px;
    content: "";
    background: linear-gradient(90deg, var(--rimehand-accent), transparent);
  }

  .eyebrow {
    margin: 0 0 1.5rem;
    color: var(--rimehand-accent);
    font-family: ui-monospace, "SFMono-Regular", Consolas, monospace;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  h1 {
    max-width: 12ch;
    margin: 0;
    color: var(--rimehand-ink);
    font-size: clamp(3rem, 9vw, 6.8rem);
    font-weight: 800;
    letter-spacing: -0.065em;
    line-height: 0.92;
  }

  h1 .accent {
    color: var(--rimehand-accent);
    text-shadow: 0 0 2rem
      color-mix(in srgb, var(--rimehand-accent) 32%, transparent);
  }

  .description {
    max-width: 43rem;
    margin: 2rem 0 0;
    color: var(--rimehand-muted);
    font-size: clamp(1rem, 2vw, 1.2rem);
    line-height: 1.75;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1.25rem 1.75rem;
    align-items: center;
    margin-top: 2.5rem;
  }

  .primary-action {
    display: inline-flex;
    gap: 0.8rem;
    align-items: center;
    justify-content: center;
    min-height: 3.5rem;
    padding: 0.9rem 1.35rem;
    border: 1px solid var(--rimehand-accent);
    border-radius: 0.75rem;
    color: var(--rimehand-surface);
    background: var(--rimehand-accent);
    font-family: ui-monospace, "SFMono-Regular", Consolas, monospace;
    font-size: 0.88rem;
    font-weight: 800;
    text-decoration: none;
    box-shadow: 0 0.8rem 2.5rem
      color-mix(in srgb, var(--rimehand-accent) 22%, transparent);
    transition:
      transform 180ms ease,
      box-shadow 180ms ease,
      filter 180ms ease;
  }

  .primary-action:hover {
    filter: brightness(1.08);
    transform: translateY(-2px);
    box-shadow: 0 1rem 3rem
      color-mix(in srgb, var(--rimehand-accent) 30%, transparent);
  }

  .primary-action:focus-visible,
  .email-link:focus-visible {
    outline: 3px solid
      color-mix(in srgb, var(--rimehand-accent) 42%, transparent);
    outline-offset: 4px;
  }

  .email-link {
    padding-block: 0.75rem;
    color: var(--rimehand-ink);
    font-family: ui-monospace, "SFMono-Regular", Consolas, monospace;
    font-size: 0.88rem;
    text-decoration-color: color-mix(
      in srgb,
      var(--rimehand-accent) 55%,
      transparent
    );
    text-underline-offset: 0.35rem;
  }

  .email-link:hover {
    color: var(--rimehand-accent);
  }

  .project-note {
    margin: clamp(3rem, 8vw, 5.5rem) 0 0;
    color: var(--rimehand-muted-subtle);
    font-family: ui-monospace, "SFMono-Regular", Consolas, monospace;
    font-size: 0.68rem;
    letter-spacing: 0.13em;
    text-transform: uppercase;
  }

  .glow-orb-one {
    top: 10%;
    left: 3%;
    width: 25rem;
    height: 25rem;
    background: rgba(145, 226, 255, 0.14);
  }

  .glow-orb-two {
    right: 0;
    bottom: 0;
    width: 21rem;
    height: 21rem;
    background: rgba(119, 194, 255, 0.12);
  }

  @media (max-width: 40rem) {
    .rimehand-page {
      place-items: start center;
      padding-top: 2.5rem;
    }

    .actions {
      align-items: stretch;
      flex-direction: column;
    }

    .primary-action {
      width: 100%;
    }

    .email-link {
      text-align: center;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .primary-action {
      transition: none;
    }

    .primary-action:hover {
      transform: none;
    }
  }
</style>
