---
import Layout from "../layouts/Layout.astro";
import ProjectCard from "../components/ProjectCard.astro";
import { getCollection } from "astro:content";
import { Badge, Link, Panel } from "foundationui/svelte";

const allProjects = await getCollection("projects");
const featuredProjects = allProjects
  .filter((project) => project.data.featured)
  .sort((a, b) => {
    if (a.data.priority !== b.data.priority) {
      return a.data.priority - b.data.priority;
    }
    return new Date(b.data.date).getTime() - new Date(a.data.date).getTime();
  })
  .slice(0, 4);

const skills = [
  {
    title: "Algorithms and Data Structures",
    description:
      "USACO Platinum, Codeforces Master, 2250+ LeetCode Rating, ICPC Regionals Medalist",
    tags: ["Graph Algorithms", "DP", "Game Theory"],
  },
  {
    title: "Mathematics",
    description:
      "Putnam Top 600, Illinois State Math Champion, 3x AIME Qualifier, Problemsetter for Middle and High School Math Competitions",
    tags: ["Abstract Algebra", "Analysis", "Theoretical CS"],
  },
  {
    title: "Quick Learner",
    description:
      "15+ Programming Languages, Domain-specific Applications, Modern Developer Tools, LLMs, AI-powered Platforms",
    tags: ["Rust", "Zig", "Codex"],
  },
];

const siteUrl = "https://snowballsh.com";
const homeSchema = [
  {
    "@context": "https://schema.org",
    "@type": "Person",
    "@id": `${siteUrl}/#person`,
    name: "Yinuo Huang",
    alternateName: "SnowballSH",
    url: siteUrl,
    image: `${siteUrl}/favicon.webp`,
    jobTitle: "Software Developer",
    knowsAbout: [
      "Software Engineering",
      "Web Development",
      "Algorithms",
      "Mathematics",
      "Music Production",
    ],
  },
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    "@id": `${siteUrl}/#website`,
    url: siteUrl,
    name: "SnowballSH Portfolio",
    inLanguage: "en-US",
    author: {
      "@id": `${siteUrl}/#person`,
    },
  },
];
---

<Layout
  title="SnowballSH (Yinuo Huang)"
  description="Portfolio and blog of SnowballSH (Yinuo Huang): software projects, technical writing, and creative work."
  schema={homeSchema}
>
  <main class="mx-auto w-full max-w-6xl px-4 sm:px-6">
    <section class="relative py-24 text-center sm:py-32">
      <div
        class="frost-field pointer-events-none absolute inset-0 overflow-hidden"
        aria-hidden="true"
      >
        <div class="frost-orb frost-orb-accent"></div>
        <div class="frost-orb frost-orb-aurora"></div>
        <div class="frost-orb frost-orb-high"></div>
      </div>
      <div class="relative mx-auto max-w-3xl space-y-6">
        <h1
          class="wordmark font-display text-[clamp(3rem,10vw,7.5rem)] leading-[0.95] font-bold tracking-[-0.045em] whitespace-nowrap"
        >
          SnowballSH
        </h1>
        <p
          class="text-ink-secondary font-mono text-sm font-medium tracking-[0.22em] uppercase"
        >
          Yinuo Huang
        </p>
        <p class="text-ink-secondary mx-auto max-w-2xl text-lg md:text-xl">
          I write innovative software, produce cool music, and more.
        </p>
        <div
          class="flex flex-col items-center justify-center gap-4 pt-2 text-lg sm:flex-row"
        >
          <Link href="#projects">View Projects</Link>
          <Link href="/contact">Get In Touch</Link>
        </div>
      </div>
    </section>

    <section class="py-16">
      <h2
        class="font-display text-ink mb-12 text-center text-3xl font-bold md:text-4xl"
      >
        Skills
      </h2>
      <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3">
        {
          skills.map((skill) => (
            <Panel tier="glass" padding="lg" class="flex flex-col gap-3">
              <h3 class="font-display text-ink text-xl font-semibold">
                {skill.title}
              </h3>
              <p class="text-ink-secondary grow">{skill.description}</p>
              <div class="flex flex-wrap gap-2">
                {skill.tags.map((tag) => (
                  <Badge tone="accent">{tag}</Badge>
                ))}
              </div>
            </Panel>
          ))
        }
      </div>
    </section>

    <section id="projects" class="py-16">
      <h2
        class="font-display text-ink mb-12 text-center text-3xl font-bold md:text-4xl"
      >
        Featured Projects
      </h2>
      <div class="grid grid-cols-1 gap-6 lg:grid-cols-2">
        {featuredProjects.map((project) => <ProjectCard project={project} />)}
      </div>
      <div class="mt-12 text-center text-lg">
        <Link href="/projects">View All Projects ({allProjects.length})</Link>
      </div>
    </section>

    <section id="contact" class="py-16 pb-24">
      <Panel
        tier="glass"
        padding="lg"
        class="mx-auto max-w-2xl space-y-4 text-center"
      >
        <h2 class="font-display text-ink text-3xl font-bold">
          Problems are Better Solved Together
        </h2>
        <p class="text-ink-secondary text-lg">
          Noticing any problems that can be solved with technologies? Have any
          awesome ideas? Let's innovate together!
        </p>
        <p class="text-lg">
          <Link href="/contact">Contact Me</Link>
        </p>
      </Panel>
    </section>
  </main>
</Layout>

<style>
  .wordmark {
    color: transparent;
    background-image:
      linear-gradient(
        105deg,
        transparent 42%,
        var(--fui-glass-sheen) 50%,
        transparent 58%
      ),
      linear-gradient(
        168deg,
        var(--fui-ink) 8%,
        color-mix(in oklab, var(--fui-accent) 62%, var(--fui-ink)) 55%,
        color-mix(in oklab, var(--fui-aurora) 78%, var(--fui-ink)) 96%
      );
    background-size:
      260% 100%,
      100% 100%;
    background-position:
      -160% 0,
      0 0;
    background-clip: text;
    -webkit-background-clip: text;
    animation: sheen 1.6s ease-in-out 0.4s forwards;
  }

  @keyframes sheen {
    to {
      background-position:
        260% 0,
        0 0;
    }
  }

  .frost-field {
    mask-image: radial-gradient(
      100% 90% at 50% 50%,
      black 30%,
      transparent 82%
    );
  }

  .frost-orb {
    position: absolute;
    border-radius: 50%;
    filter: blur(56px);
  }

  .frost-orb-accent {
    top: 4%;
    left: 8%;
    width: clamp(12rem, 36vw, 22rem);
    height: clamp(12rem, 36vw, 22rem);
    background: color-mix(in oklab, var(--fui-accent) 18%, transparent);
  }

  .frost-orb-aurora {
    right: 6%;
    bottom: 4%;
    width: clamp(10rem, 32vw, 19rem);
    height: clamp(10rem, 32vw, 19rem);
    background: color-mix(in oklab, var(--fui-aurora) 16%, transparent);
  }

  .frost-orb-high {
    top: 8%;
    right: 22%;
    width: clamp(6rem, 18vw, 11rem);
    height: clamp(6rem, 18vw, 11rem);
    background: color-mix(in oklab, var(--fui-glass-sheen) 55%, transparent);
  }

  @media (prefers-reduced-motion: no-preference) {
    .frost-orb {
      animation: drift 26s ease-in-out infinite alternate;
    }

    .frost-orb-aurora {
      animation-delay: -9s;
    }

    .frost-orb-high {
      animation-delay: -18s;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .wordmark {
      animation: none;
    }
  }

  @keyframes drift {
    to {
      transform: translate3d(2.5rem, -1.5rem, 0) scale(1.08);
    }
  }
</style>
