---
import Layout from "../layouts/Layout.astro";
import ProjectCard from "../components/ProjectCard.astro";
import { getCollection } from "astro:content";
import { Badge, Link, Panel } from "foundationui/svelte";

const allProjects = await getCollection("projects");
const featuredProjects = allProjects
  .filter((project) => project.data.featured)
  .sort((a, b) => {
    if (a.data.priority !== b.data.priority) {
      return a.data.priority - b.data.priority;
    }
    return new Date(b.data.date).getTime() - new Date(a.data.date).getTime();
  })
  .slice(0, 4);

const wordmarkText = "SnowballSH";
const accentStart = wordmarkText.length - 2;
const maxIndex = wordmarkText.length - 1;
const wordmark = [...wordmarkText].map((char, index) => ({
  char,
  index,
  weight: Math.round(300 + (600 * index) / maxIndex),
  accent: index >= accentStart,
}));

const skills = [
  {
    title: "Algorithms and Data Structures",
    description:
      "USACO Platinum, Codeforces Master, 2250+ LeetCode Rating, ICPC Regionals Medalist",
    tags: ["Graph Algorithms", "DP", "Game Theory"],
  },
  {
    title: "Mathematics",
    description:
      "Putnam Top 600, Illinois State Math Champion, 3x AIME Qualifier, Problemsetter for Middle and High School Math Competitions",
    tags: ["Abstract Algebra", "Analysis", "Theoretical CS"],
  },
  {
    title: "Quick Learner",
    description:
      "15+ Programming Languages, Domain-specific Applications, Modern Developer Tools, LLMs, AI-powered Platforms",
    tags: ["Rust", "Zig", "Codex"],
  },
];

const siteUrl = "https://snowballsh.com";
const homeSchema = [
  {
    "@context": "https://schema.org",
    "@type": "Person",
    "@id": `${siteUrl}/#person`,
    name: "Yinuo Huang",
    alternateName: "SnowballSH",
    url: siteUrl,
    image: `${siteUrl}/favicon.webp`,
    jobTitle: "Software Developer",
    knowsAbout: [
      "Software Engineering",
      "Web Development",
      "Algorithms",
      "Mathematics",
      "Music Production",
    ],
  },
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    "@id": `${siteUrl}/#website`,
    url: siteUrl,
    name: "SnowballSH Portfolio",
    inLanguage: "en-US",
    author: {
      "@id": `${siteUrl}/#person`,
    },
  },
];
---

<Layout
  title="SnowballSH (Yinuo Huang)"
  description="Portfolio and blog of SnowballSH (Yinuo Huang): software projects, technical writing, and creative work."
  schema={homeSchema}
>
  <main class="mx-auto w-full max-w-6xl px-4 sm:px-6">
    <section class="py-24 text-center sm:py-32">
      <div class="mx-auto max-w-3xl space-y-6">
        <h1
          aria-label="SnowballSH"
          class="wordmark font-display text-ink text-[clamp(3rem,10vw,7.5rem)] leading-[0.95] tracking-[-0.045em] whitespace-nowrap"
        >
          {
            wordmark.map((letter) => (
              <span
                aria-hidden="true"
                class:list={["wordmark-letter", letter.accent && "text-accent"]}
                style={`--w:${letter.weight};--i:${letter.index}`}
              >
                {letter.char}
              </span>
            ))
          }
        </h1>
        <p
          class="text-ink-secondary font-mono text-sm font-medium tracking-[0.22em] uppercase"
        >
          Yinuo Huang
        </p>
        <p class="text-ink-secondary mx-auto max-w-2xl text-lg md:text-xl">
          I write innovative software, produce cool music, and more.
        </p>
        <div
          class="flex flex-col items-center justify-center gap-4 pt-2 text-lg sm:flex-row"
        >
          <Link href="#projects">View Projects</Link>
          <Link href="/contact">Get In Touch</Link>
        </div>
      </div>
    </section>

    <section class="py-16">
      <h2
        class="font-display text-ink mb-12 text-center text-3xl font-bold md:text-4xl"
      >
        Skills
      </h2>
      <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3">
        {
          skills.map((skill) => (
            <Panel tier="glass" padding="lg" class="flex flex-col gap-3">
              <h3 class="font-display text-ink text-xl font-semibold">
                {skill.title}
              </h3>
              <p class="text-ink-secondary grow">{skill.description}</p>
              <div class="flex flex-wrap gap-2">
                {skill.tags.map((tag) => (
                  <Badge tone="accent">{tag}</Badge>
                ))}
              </div>
            </Panel>
          ))
        }
      </div>
    </section>

    <section id="projects" class="py-16">
      <h2
        class="font-display text-ink mb-12 text-center text-3xl font-bold md:text-4xl"
      >
        Featured Projects
      </h2>
      <div class="grid grid-cols-1 gap-6 lg:grid-cols-2">
        {featuredProjects.map((project) => <ProjectCard project={project} />)}
      </div>
      <div class="mt-12 text-center text-lg">
        <Link href="/projects">View All Projects ({allProjects.length})</Link>
      </div>
    </section>

    <section id="contact" class="py-16 pb-24">
      <Panel
        tier="glass"
        padding="lg"
        class="mx-auto max-w-2xl space-y-4 text-center"
      >
        <h2 class="font-display text-ink text-3xl font-bold">
          Problems are Better Solved Together
        </h2>
        <p class="text-ink-secondary text-lg">
          Noticing any problems that can be solved with technologies? Have any
          awesome ideas? Let's innovate together!
        </p>
        <p class="text-lg">
          <Link href="/contact">Contact Me</Link>
        </p>
      </Panel>
    </section>
  </main>
</Layout>

<style>
  .wordmark-letter {
    display: inline-block;
    font-weight: var(--w);
    animation: gather 0.9s cubic-bezier(0.22, 1, 0.36, 1) backwards;
    animation-delay: calc(var(--i) * 45ms);
  }

  @keyframes gather {
    from {
      font-weight: 200;
      opacity: 0;
      transform: translateY(0.08em);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .wordmark-letter {
      animation: none;
    }
  }
</style>
