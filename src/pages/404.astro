---
import Layout from "../layouts/Layout.astro";
import { Link } from "foundationui/svelte";
---

<Layout
  cta={false}
  title="Page Not Found - SnowballSH (Yinuo Huang)"
  description="This page does not exist."
  noindex={true}
>
  <main class="mx-auto w-full max-w-2xl px-4 sm:px-6">
    <section class="space-y-8 py-32 text-center">
      <p class="font-display text-accent text-8xl font-bold md:text-9xl">404</p>
      <h1 class="font-display text-ink text-3xl font-bold md:text-4xl">
        This page melted away
      </h1>
      <p class="text-ink-secondary mx-auto max-w-xl text-lg">
        The page you are looking for does not exist or has moved. If you
        followed a link here, it may be pointing at a snowball that has long
        since rolled on.
      </p>
      <div
        class="flex flex-wrap items-center justify-center gap-x-6 gap-y-2 pt-4 text-lg"
      >
        <Link href="/">Home</Link>
        <Link href="/projects">Projects</Link>
        <Link href="https://blogs.snowballsh.com" external>Blogs</Link>
        <Link href="/contact">Contact</Link>
      </div>
    </section>
  </main>
</Layout>
