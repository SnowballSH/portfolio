---
import { getCollection } from "astro:content";
import { Link, Panel } from "foundationui/svelte";
import ProjectCard from "../../components/ProjectCard.astro";
import { categories, categoryOrder } from "../../data/categories";
import Layout from "../../layouts/Layout.astro";

const allProjects = await getCollection("projects");
const sortedProjects = allProjects.sort((a, b) => {
  if (a.data.priority !== b.data.priority) {
    return a.data.priority - b.data.priority;
  }
  return b.data.date.getTime() - a.data.date.getTime();
});

const groups = categoryOrder
  .filter((category) => category !== "earlier")
  .map((category) => ({
    label: categories[category],
    projects: sortedProjects.filter(
      (project) => project.data.category === category,
    ),
  }))
  .filter((group) => group.projects.length > 0);

const eagerProjectId = groups[0]?.projects[0]?.id;

const earlierProjects = allProjects
  .filter((project) => project.data.category === "earlier")
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const site = Astro.site ?? new URL("https://snowballsh.com");
const projectListSchema = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  name: "Projects - SnowballSH",
  description:
    "Projects by SnowballSH (Yinuo Huang): chess engines, games, infrastructure, machine learning, and hackathon builds.",
  url: new URL(Astro.url.pathname, site).toString(),
  mainEntity: {
    "@type": "ItemList",
    itemListElement: sortedProjects.map((project, index) => ({
      "@type": "ListItem",
      position: index + 1,
      url: new URL(`/projects/${project.id}`, site).toString(),
      name: project.data.title,
    })),
  },
};
---

<Layout
  title="Projects - SnowballSH (Yinuo Huang)"
  description="Projects by SnowballSH (Yinuo Huang): chess engines, games, infrastructure, machine learning, and hackathon builds."
  keywords={[
  "SnowballSH",
  "Yinuo Huang",
  "software projects",
  "portfolio",
  "chess engine",
  "infrastructure",
]}
  schema={projectListSchema}
>
  <main class="mx-auto w-full max-w-6xl px-4 py-10 sm:px-6">
    <Link href="/" subtle> ← Back to Portfolio </Link>

    <section class="py-14 text-center">
      <h1
        class="font-display text-ink mb-6 text-4xl font-bold tracking-tight md:text-5xl"
      >
        Projects
      </h1>
      <p class="text-ink-secondary mx-auto max-w-3xl text-lg md:text-xl">
        Chess engines, games, the infrastructure I run, and tools I built along
        the way.
      </p>
    </section>

    {groups.map((group) => (
  <section class="py-8">
    <h2 class="font-display text-ink mb-8 text-2xl font-bold md:text-3xl">
      {group.label}
    </h2>
    <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3">
      {group.projects.map((project) => (
        <ProjectCard
          project={project}
          showFeaturedIcon={true}
          loading={project.id === eagerProjectId ? "eager" : "lazy"}
        />
      ))}
    </div>
  </section>
))}

    {earlierProjects.length > 0 && (
  <section class="py-8">
    <h2 class="font-display text-ink mb-8 text-2xl font-bold md:text-3xl">
      {categories.earlier}
    </h2>
    <Panel tier="glass" padding="lg">
      <ul class="divide-line divide-y">
        {earlierProjects.map((project) => (
          <li class="flex flex-col gap-1 py-4 first:pt-0 last:pb-0 sm:flex-row sm:items-baseline sm:gap-4">
            <span class="text-ink-muted w-12 shrink-0 font-mono text-sm">
              {project.data.date.getUTCFullYear()}
            </span>
            <span>
              <Link href={`/projects/${project.id}`} class="font-medium">
                {project.data.title}
              </Link>
              <span class="text-ink-secondary">
                {" "}
                — {project.data.shortDescription}
              </span>
            </span>
          </li>
        ))}
      </ul>
    </Panel>
  </section>
)}
  </main>
</Layout>
