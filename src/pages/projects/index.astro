---
import Layout from "../../layouts/Layout.astro";
import ProjectCard from "../../components/ProjectCard.astro";
import { getCollection } from "astro:content";

const allProjects = await getCollection("projects");
const sortedProjects = allProjects.sort((a, b) => {
  if (a.data.priority !== b.data.priority) {
    return a.data.priority - b.data.priority;
  }
  return new Date(b.data.date).getTime() - new Date(a.data.date).getTime();
});

const firstProjectSlug = sortedProjects[0]?.slug;

const projectsByCategory = sortedProjects.reduce(
  (acc, project) => {
    const category = project.data.category;
    if (!acc[category]) {
      acc[category] = [];
    }
    acc[category].push(project);
    return acc;
  },
  {} as Record<string, typeof sortedProjects>,
);

const categoryOrder = ["other", "web", "mobile", "desktop", "api", "library"];
const orderedCategories = categoryOrder.filter(
  (cat) => projectsByCategory[cat],
);

const categoryLabels = {
  other: "General Projects",
  web: "Web Applications",
  mobile: "Mobile Apps",
  desktop: "Desktop Applications",
  api: "APIs & Backend",
  library: "Libraries & Tools",
};

const site = Astro.site ?? new URL("https://snowballsh.github.io");
const projectListSchema = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  name: "Projects - SnowballSH",
  description:
    "Portfolio projects by SnowballSH (Yinuo Huang), including web, mobile, desktop, API, and library work.",
  url: new URL(Astro.url.pathname, site).toString(),
  mainEntity: {
    "@type": "ItemList",
    itemListElement: sortedProjects.map((project, index) => ({
      "@type": "ListItem",
      position: index + 1,
      url: new URL(`/projects/${project.slug}`, site).toString(),
      name: project.data.title,
    })),
  },
};
---

<Layout
  title="Projects - SnowballSH (Yinuo Huang)"
  description="Discover SnowballSH (Yinuo Huang)'s portfolio of web applications, tools, and creative projects built with modern technologies."
  keywords={[
    "SnowballSH",
    "Yinuo Huang",
    "software projects",
    "portfolio",
    "web development",
    "programming",
  ]}
  schema={projectListSchema}
>
  <div class="futuristic-bg"></div>
  <div class="geometric-overlay"></div>

  <div class="pointer-events-none fixed inset-0 z-0 overflow-hidden">
    <div class="particle"></div>
    <div class="particle"></div>
    <div class="particle"></div>
    <div class="particle"></div>
    <div class="particle"></div>
    <div class="particle"></div>
    <div class="particle"></div>
    <div class="particle"></div>
    <div class="particle"></div>
  </div>

  <main class="relative z-10 min-h-screen">
    <div class="container mx-auto px-6 pt-28 md:pt-32">
      <a
        href="/"
        class="text-primary-400 hover:text-primary-300 mb-8 inline-flex items-center transition-colors"
      >
        ← Back to Portfolio
      </a>
    </div>

    <section class="py-20">
      <div class="container mx-auto px-6 text-center">
        <h1
          class="section-heading mb-6 text-5xl font-bold text-white md:text-6xl"
        >
          My Projects
        </h1>
        <p class="section-lead mx-auto mb-8 max-w-3xl text-lg md:text-xl">
          A collection of applications, tools, and experiments built with modern
          technologies. Each project represents a learning journey and a step
          forward in my development skills.
        </p>
        <p class="text-sm text-sky-100/70 md:text-base">
          {sortedProjects.length} projects and counting...
        </p>
      </div>
    </section>

    {
      orderedCategories.map((category) => (
        <section class="py-12">
          <div class="container mx-auto px-6">
            <h2 class="section-heading mb-8 text-3xl font-bold text-white">
              {categoryLabels[category as keyof typeof categoryLabels] ||
                category}
            </h2>

            <div class="mosaic-grid project-grid grid grid-cols-1 gap-8 md:grid-cols-2 lg:grid-cols-3">
              {projectsByCategory[category].map((project) => (
                <ProjectCard
                  project={project}
                  showFeaturedIcon={true}
                  loading={project.slug === firstProjectSlug ? "eager" : "lazy"}
                />
              ))}
            </div>
          </div>
        </section>
      ))
    }

    <section class="py-20">
      <div class="container mx-auto px-6 text-center">
        <div class="glass-panel mx-auto max-w-2xl">
          <h2 class="section-heading mb-4 text-3xl font-bold text-white">
            Let's Innovate Together
          </h2>
          <p class="section-lead mb-8 text-lg md:text-xl">
            Any questions? Any suggestions? Any creative ideas?
          </p>
          <a
            href="/contact"
            class="glass-button inline-block px-8 py-4 text-lg font-semibold"
          >
            Contact Me
          </a>
        </div>
      </div>
    </section>
  </main>
</Layout>
