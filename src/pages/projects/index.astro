---
import Layout from "../../layouts/Layout.astro";
import ProjectCard from "../../components/ProjectCard.astro";
import { getCollection } from "astro:content";
import { Link, Panel } from "foundationui/svelte";

const allProjects = await getCollection("projects");
const sortedProjects = allProjects.sort((a, b) => {
  if (a.data.priority !== b.data.priority) {
    return a.data.priority - b.data.priority;
  }
  return new Date(b.data.date).getTime() - new Date(a.data.date).getTime();
});

const firstProjectSlug = sortedProjects[0]?.id;

const projectsByCategory = sortedProjects.reduce(
  (acc, project) => {
    const category = project.data.category;
    if (!acc[category]) {
      acc[category] = [];
    }
    acc[category].push(project);
    return acc;
  },
  {} as Record<string, typeof sortedProjects>,
);

const categoryOrder = ["other", "web", "mobile", "desktop", "api", "library"];
const orderedCategories = categoryOrder.filter(
  (cat) => projectsByCategory[cat],
);

const categoryLabels = {
  other: "General Projects",
  web: "Web Applications",
  mobile: "Mobile Apps",
  desktop: "Desktop Applications",
  api: "APIs & Backend",
  library: "Libraries & Tools",
};

const site = Astro.site ?? new URL("https://snowballsh.com");
const projectListSchema = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  name: "Projects - SnowballSH",
  description:
    "Portfolio projects by SnowballSH (Yinuo Huang), including web, mobile, desktop, API, and library work.",
  url: new URL(Astro.url.pathname, site).toString(),
  mainEntity: {
    "@type": "ItemList",
    itemListElement: sortedProjects.map((project, index) => ({
      "@type": "ListItem",
      position: index + 1,
      url: new URL(`/projects/${project.id}`, site).toString(),
      name: project.data.title,
    })),
  },
};
---

<Layout
  title="Projects - SnowballSH (Yinuo Huang)"
  description="Discover SnowballSH (Yinuo Huang)'s portfolio of web applications, tools, and creative projects built with modern technologies."
  keywords={[
    "SnowballSH",
    "Yinuo Huang",
    "software projects",
    "portfolio",
    "web development",
    "programming",
  ]}
  schema={projectListSchema}
>
  <main class="mx-auto w-full max-w-6xl px-4 py-10 sm:px-6">
    <Link href="/" subtle>← Back to Portfolio</Link>

    <section class="py-14 text-center">
      <h1
        class="font-display text-ink mb-6 text-4xl font-bold tracking-tight md:text-5xl"
      >
        My Projects
      </h1>
      <p class="text-ink-secondary mx-auto mb-4 max-w-3xl text-lg md:text-xl">
        A collection of applications, tools, and experiments built with modern
        technologies. Each project represents a learning journey and a step
        forward in my development skills.
      </p>
      <p class="text-ink-muted text-sm md:text-base">
        {sortedProjects.length} projects and counting...
      </p>
    </section>

    {
      orderedCategories.map((category) => (
        <section class="py-8">
          <h2 class="font-display text-ink mb-8 text-2xl font-bold md:text-3xl">
            {categoryLabels[category as keyof typeof categoryLabels] ||
              category}
          </h2>
          <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3">
            {projectsByCategory[category].map((project) => (
              <ProjectCard
                project={project}
                showFeaturedIcon={true}
                loading={project.id === firstProjectSlug ? "eager" : "lazy"}
              />
            ))}
          </div>
        </section>
      ))
    }

    <section class="py-16">
      <Panel
        tier="glass"
        padding="lg"
        class="mx-auto max-w-2xl space-y-4 text-center"
      >
        <h2 class="font-display text-ink text-2xl font-bold md:text-3xl">
          Let's Innovate Together
        </h2>
        <p class="text-ink-secondary text-lg">
          Any questions? Any suggestions? Any creative ideas?
        </p>
        <p class="text-lg">
          <Link href="/contact">Contact Me</Link>
        </p>
      </Panel>
    </section>
  </main>
</Layout>
