---
import Layout from "../../layouts/Layout.astro";
import { getCollection } from "astro:content";
import type { GetStaticPaths } from "astro";
import type { CollectionEntry } from "astro:content";
import { Badge, Link, Panel, Prose } from "foundationui/svelte";

export const getStaticPaths: GetStaticPaths = async () => {
  const projects = await getCollection("projects");
  return projects.map((project) => ({
    params: { slug: project.id },
    props: { project },
  }));
};

interface Props {
  project: CollectionEntry<"projects">;
}

const { project } = Astro.props as Props;
const contentHtml = project.rendered?.html;
if (contentHtml === undefined) {
  throw new Error(`Project ${project.id} has no rendered HTML content`);
}
const {
  title,
  shortDescription,
  date,
  technologies,
  image,
  imageAlt,
  githubUrl,
  liveUrl,
  demoUrl,
  links,
  status,
  category,
} = project.data;

const formattedDate = new Intl.DateTimeFormat("en-US", {
  year: "numeric",
  month: "long",
  day: "numeric",
  timeZone: "UTC",
}).format(date);

const externalLinks = [
  ...(liveUrl ? [{ url: liveUrl, label: "View Live Site" }] : []),
  ...(demoUrl ? [{ url: demoUrl, label: "Try Demo" }] : []),
  ...(githubUrl ? [{ url: githubUrl, label: "View Source" }] : []),
  ...(links ?? []).map((link) => ({ url: link.url, label: link.label })),
];

const site = Astro.site ?? new URL("https://snowballsh.com");
const canonicalUrl = new URL(Astro.url.pathname, site).toString();
const publishedIso = date.toISOString();
const projectSchema = {
  "@context": "https://schema.org",
  "@type": "SoftwareSourceCode",
  name: title,
  description: shortDescription,
  url: canonicalUrl,
  codeRepository: githubUrl,
  datePublished: publishedIso,
  dateModified: publishedIso,
  programmingLanguage: technologies,
  author: {
    "@type": "Person",
    name: "Yinuo Huang",
    alternateName: "SnowballSH",
    url: new URL("/", site).toString(),
  },
  image: new URL(image || "/favicon.webp", site).toString(),
  keywords: [category, ...technologies],
};
---

<Layout
  title={`${title} - SnowballSH (Yinuo Huang)`}
  description={shortDescription}
  type="article"
  image={image || "/favicon.webp"}
  publishedTime={publishedIso}
  modifiedTime={publishedIso}
  keywords={["SnowballSH", "Yinuo Huang", "project", category, ...technologies]}
  schema={projectSchema}
>
  <main class="mx-auto w-full max-w-4xl px-4 py-10 sm:px-6">
    <Link href="/projects" subtle>← Back to Projects</Link>

    <section class="py-10">
      <div
        class="text-ink-secondary mb-6 flex flex-wrap items-center gap-x-3 gap-y-2"
      >
        <span>{formattedDate}</span>
        <span class="text-ink-muted">•</span>
        <span class="capitalize">{category}</span>
        {
          status !== "completed" && (
            <>
              <span class="text-ink-muted">•</span>
              {status === "in-progress" ? (
                <Badge tone="aurora">In Progress</Badge>
              ) : (
                <Badge tone="neutral">Planned</Badge>
              )}
            </>
          )
        }
      </div>

      <h1
        class="font-display text-ink mb-6 text-4xl font-bold tracking-tight md:text-5xl"
      >
        {title}
      </h1>

      <p class="text-ink-secondary mb-8 text-lg md:text-xl">
        {shortDescription}
      </p>

      <div class="mb-8 flex flex-wrap gap-2">
        {
          technologies.map((tech: string) => (
            <Badge tone="accent">{tech}</Badge>
          ))
        }
      </div>

      {
        externalLinks.length > 0 && (
          <div class="flex flex-wrap gap-x-5 gap-y-2 text-lg">
            {externalLinks.map((link) => (
              <Link href={link.url} external>
                {link.label}
              </Link>
            ))}
          </div>
        )
      }
    </section>

    {
      image && (
        <section class="pb-10">
          <Panel tier="glass" padding="md">
            <img
              src={image}
              alt={imageAlt || `Screenshot of ${title}`}
              width="800"
              height="480"
              class="h-80 w-full rounded-md object-contain"
              loading="eager"
            />
          </Panel>
        </section>
      )
    }

    <section class="pb-10">
      <Panel tier="glass" padding="lg">
        <Prose html={contentHtml} client:idle />
      </Panel>
    </section>

    <section class="py-10 text-center text-lg">
      <Link href="/projects">View All Projects</Link>
    </section>
  </main>
</Layout>
